{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adfDevSqlAdlsMigration"
		},
		"LK_ADL_ming_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'LK_ADL_ming'"
		},
		"LK_Adls_Mig_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'LK_Adls_Mig'"
		},
		"AKV_LK_sql_server_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://msSqlLocal.vault.azure.net/"
		},
		"LK_ADL_ming_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://adlsdevsqladlsmigration.dfs.core.windows.net/"
		},
		"LK_Adls_Mig_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://adlsdevsqladlsmigration.dfs.core.windows.net/"
		},
		"LK_SqlServer_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "GUNA_SEKHAR\\MSLOCALDB"
		},
		"LK_SqlServer_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "ms_migration"
		},
		"LK_SqlServer_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "sa"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adfDevSqlAdlsMigration_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"LK_ADL_ming_accountKey": {
						"value": "[parameters('LK_ADL_ming_accountKey')]"
					},
					"LK_Adls_Mig_accountKey": {
						"value": "[parameters('LK_Adls_Mig_accountKey')]"
					},
					"AKV_LK_sql_server_properties_typeProperties_baseUrl": {
						"value": "[parameters('AKV_LK_sql_server_properties_typeProperties_baseUrl')]"
					},
					"LK_ADL_ming_properties_typeProperties_url": {
						"value": "[parameters('LK_ADL_ming_properties_typeProperties_url')]"
					},
					"LK_Adls_Mig_properties_typeProperties_url": {
						"value": "[parameters('LK_Adls_Mig_properties_typeProperties_url')]"
					},
					"LK_SqlServer_properties_typeProperties_server": {
						"value": "[parameters('LK_SqlServer_properties_typeProperties_server')]"
					},
					"LK_SqlServer_properties_typeProperties_database": {
						"value": "[parameters('LK_SqlServer_properties_typeProperties_database')]"
					},
					"LK_SqlServer_properties_typeProperties_userName": {
						"value": "[parameters('LK_SqlServer_properties_typeProperties_userName')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}